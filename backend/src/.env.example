## Node ENV
NODE_ENV=development

## SERVER PORT
PORT=5000

## DATABASE
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

## JWT & SESSION
SECRET_KEY=your_jwt_secret_key
SESSION_SECRET=your_session_secret

## NODEMAILER
NODEMAILER_EMAIL=your_email@gmail.com
NODEMAILER_PASSWORD=your_email_app_password
NODEMAILER_APP=Bhavani Motors

## SUPABASE STORAGE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=your_bucket_name
BUCKET_NAME=your_bucket_name

## WHATSAPP CLOUD API
WA_PHONE_NUMBER_ID=your_wa_phone_number_id
WA_ACCESS_TOKEN=your_wa_access_token
WA_TEMPLATE_NAME=your_template_name
WA_IMAGE_TEMPLATE_NAME=your_image_template_name
WA_INVOICE_TEMPLATE_NAME=your_invoice_template_name
